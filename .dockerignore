# Build context for the backend image is the repo root — keep it lean and never
# bake secrets, the venv, caches or internal material into the image.

# VCS / agent tooling
.git
.github
.githooks
.claude
.agents
pdca

# Python
**/__pycache__/
**/*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / frontend (the backend image doesn't need them; frontend has its own context)
node_modules/
frontend/node_modules/
frontend/dist/

# Secrets & regenerated runtime state — never ship these
.env
backend/.env
backend/exports/
backend/_alire/
**/sessions.db
**/sessions.db-wal
**/sessions.db-shm

# Internal, non-shipping material that happens to sit under data/
data/*.ipynb
data/*.pdf
**/*.docx

# Misc
*.log
.DS_Store
Thumbs.db
