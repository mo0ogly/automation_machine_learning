# automation_machine_learning — Docker stack configuration.
# Copy to .env (gitignored); docker compose reads it automatically. Every value
# has a safe default, so an empty .env still boots (the agent falls back to a
# deterministic heuristic when GROQ_API_KEY is absent).

# Groq API key for the per-stage refinement agent. Get one at
# https://console.groq.com/keys . Leave empty to run on the heuristic fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Host ports (change if 8000 / 5173 are already taken on your machine).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Session persistence (SQLite on the mlauto-data volume). 0 = pure in-memory.
ML_PERSIST_SESSIONS=1

# Where the built frontend points its API calls. Default tracks BACKEND_PORT;
# override only for a remote deployment (e.g. http://my-host:8000).
# VITE_API_URL=http://localhost:8000
