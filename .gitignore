# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ─── Secrets / env ───────────────────────────────────────
.env
backend/.env
.gitlab.env
*.local

# ─── ML artefacts ────────────────────────────────────────
backend/exports/
*.pkl
*.joblib

# ─── App runtime state (regenerated) ─────────────────────
backend/_alire/

# ─── Session persistence (SQLite mirror, regenerated) ────
sessions.db
sessions.db-wal
sessions.db-shm
backend/sessions.db*

# ─── Node / Vite ─────────────────────────────────────────
node_modules/
frontend/dist/
frontend/node_modules/

# ─── Données internes (ne pas committer) ─────────────────
data/*.ipynb
data/*.pdf
# Matrices de features régénérables (build_aegis_text_features.py)
data/aegis_text_features/
# Rapport de vérification régénérable (verify_coldstart_lift.py)
data/coldstart_lift_report.json

# ─── OS / editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ─── Backends IA (clés write-only, ne pas committer) ─────
backend/ai_backends.json
backend/prompt_overrides.json

# ─── CA interne (info d'infra interne, ne pas committer) ─
# Place ici les .crt de ta CA d'entreprise pour que le backend Docker leur
# fasse confiance (voir backend/Dockerfile) ; le dossier reste dans le repo
# (.gitkeep) mais son contenu réel ne l'est pas.
backend/certs/*.crt
backend/certs/*.pem
