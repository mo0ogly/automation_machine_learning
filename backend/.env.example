# Backend ML Automator — environment template
# Copy to backend/.env and fill in your key (backend/.env is gitignored).

# Groq API key — used by the per-stage refinement agent (llm_agent.py).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Model used for refinement recommendations (Groq).
GROQ_MODEL=openai/gpt-oss-120b

# -- Optional alternative providers (all OpenAI-compatible) -----------------
# Full catalog ported from recette_IA_agents (backend/ai_providers.py). Any
# provider can be activated either from the settings UI (write-only key) or by
# setting its env var below. At call time resolve() uses the per-backend stored
# key first, else the provider env var. Uncomment + fill the ones you use.
#   OPENAI_API_KEY=
#   MISTRAL_API_KEY=
#   DEEPSEEK_API_KEY=
#   XAI_API_KEY=               # xAI / Grok
#   OPENROUTER_API_KEY=        # OpenRouter aggregator
#   TOGETHER_API_KEY=          # Together AI
#   FIREWORKS_API_KEY=         # Fireworks AI
#   KIMI_API_KEY=              # Moonshot / Kimi
#   GLM_API_KEY=               # Z.AI / Zhipu GLM (glm-5.2, ... ; https://api.z.ai/api/paas/v4)
#   DASHSCOPE_API_KEY=         # Alibaba DashScope / Qwen
#   NVIDIA_API_KEY=            # Nvidia NIM
#   NOUS_API_KEY=              # Nous Research
#   OLLAMA_API_KEY=            # Ollama Cloud
#   NOVITA_API_KEY=            # Novita AI
#   STEPFUN_API_KEY=           # StepFun
#   ARCEEAI_API_KEY=           # Arcee AI
#   XIAOMI_API_KEY=            # Xiaomi MiMo
#   GMI_API_KEY=               # GMI Serving
#   HF_TOKEN=                  # Hugging Face Router
#   OPENCODE_ZEN_API_KEY=      # OpenCode Zen
#   KILOCODE_API_KEY=          # Kilo Code
#   ALIBABA_CODING_PLAN_API_KEY=  # Alibaba Coding Plan (Qwen)
#   QWEN_API_KEY=              # Qwen Portal
#   CEREBRAS_API_KEY=          # Cerebras
# Local gateways (Ollama / LiteLLM / vLLM): use provider "openai_compat" in the
# UI with a per-backend base_url (no env var needed).

# Session persistence (SQLite). Sessions are mirrored to disk and survive a
# backend restart. Set ML_PERSIST_SESSIONS=0 to run purely in-memory.
# ML_PERSIST_SESSIONS=1
# ML_SESSION_DB=backend/sessions.db
